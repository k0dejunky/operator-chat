<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FDF2F8"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Operator Chat"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="#4A044E" />

        <TextView
            android:id="@+id/status_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Enter server URL + token, then Connect."
            android:textSize="13sp"
            android:textColor="#6B21A8" />

        <EditText
            android:id="@+id/url_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Server URL (e.g. https://amethyst2213.com/gallery)"
            android:inputType="textUri"
            android:background="@drawable/input_bg" />

        <EditText
            android:id="@+id/token_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Bridge token (GALLERY_CHAT_KEY)"
            android:inputType="textPassword"
            android:background="@drawable/input_bg" />

        <Button
            android:id="@+id/connect_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Login &amp; load inbox" />

        <!-- Inbox list -->
        <Button
            android:id="@+id/refresh_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Refresh inbox" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Inbox"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#4A044E" />

        <LinearLayout
            android:id="@+id/inbox_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="4dp" />

        <!-- Thread view -->
        <LinearLayout
            android:id="@+id/thread_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/back_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#8592; Back to inbox" />

            <TextView
                android:id="@+id/thread_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Chat"
                android:textSize="17sp"
                android:textStyle="bold"
                android:textColor="#4A044E" />

            <EditText
                android:id="@+id/reply_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:hint="Type the operator reply…"
                android:minLines="3"
                android:gravity="top"
                android:background="@drawable/input_bg" />

            <Button
                android:id="@+id/reply_button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Send operator reply" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>