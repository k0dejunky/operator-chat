<?xml version="1.0" encoding="utf-8"?>
<!-- Inbox row: avatar, member name, last message, time and unread badge.
     The old row had a story ring + a bare ☆ glyph for "favourite" and hardcoded
     a purple that ignored the theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <!-- Avatar: initial over a solid circle whose colour is set per member in
         code, so two members never share the same tile by accident. -->
    <FrameLayout
        android:layout_width="48dp"
        android:layout_height="48dp">

        <ImageView
            android:id="@+id/row_avatar_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:contentDescription="@null"
            android:src="@drawable/bg_avatar" />

        <TextView
            android:id="@+id/row_avatar"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="A" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="6dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/row_title"
                style="@style/Widget.OperatorChat.ListTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                tools:text="member@example.com" />

            <TextView
                android:id="@+id/row_time"
                style="@style/Widget.OperatorChat.ListMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                tools:text="14:32" />

            <TextView
                android:id="@+id/row_badge"
                android:layout_width="wrap_content"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_badge"
                android:gravity="center"
                android:minWidth="20dp"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="3"
                tools:visibility="visible" />
        </LinearLayout>

        <TextView
            android:id="@+id/row_preview"
            style="@style/Widget.OperatorChat.ListSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            tools:text="Member: is the new set up yet?" />
    </LinearLayout>
</LinearLayout>
