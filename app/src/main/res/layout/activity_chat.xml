<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- Header: story gradient strip -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/ig_gradient">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/chat_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            android:titleTextColor="@color/white"
            app:titleTextAppearance="@style/Theme.OperatorChat.ToolbarTitle"
            xmlns:app="http://schemas.android.com/apk/res-auto" />
    </FrameLayout>

    <TextView
        android:id="@+id/chat_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingLeft="16dp"
        android:paddingRight="16dp"
        android:paddingTop="6dp"
        android:paddingBottom="2dp"
        android:textSize="12sp"
        android:textColor="@color/text_secondary" />

    <!-- Messages -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/message_recycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp" />

    <!-- Emoji quick bar -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/emoji_bar"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:visibility="gone"
        android:background="@color/surface_card" />

    <!-- Bottom reply bar (Snapchat-style dark composer) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="8dp"
        android:background="@color/surface"
        android:elevation="8dp">

        <Button
            android:id="@+id/emoji_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:contentDescription="Emoji"
            android:text="😊"
            android:textSize="18sp"
            android:background="@drawable/input_bg" />

        <EditText
            android:id="@+id/reply_input"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginLeft="6dp"
            android:layout_marginRight="6dp"
            android:hint="Message…"
            android:maxLines="4"
            android:minHeight="44dp"
            android:gravity="center_vertical"
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary"
            android:inputType="textMultiLine|textCapSentences"
            android:imeOptions="actionSend"
            android:background="@drawable/input_bg" />

        <Button
            android:id="@+id/attach_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:contentDescription="Attach file"
            android:text="📷"
            android:textSize="18sp"
            android:background="@drawable/input_bg" />

        <Button
            android:id="@+id/send_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginLeft="6dp"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:contentDescription="Send"
            android:text="➤"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:background="@drawable/send_bg" />
    </LinearLayout>
</LinearLayout>