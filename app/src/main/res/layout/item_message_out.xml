<?xml version="1.0" encoding="utf-8"?>
<!-- Outgoing (operator) message. Right-aligned bubble with the sender header,
     delivery state and a clock under the bubble. Grouped rows drop the header
     and the corner radius via the background chosen in code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="56dp"
    android:paddingEnd="12dp"
    android:paddingTop="2dp"
    android:paddingBottom="2dp"
    android:clipToPadding="false">

    <TextView
        android:id="@+id/row_header"
        style="@style/Widget.OperatorChat.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingBottom="2dp"
        android:textStyle="bold"
        android:textColor="@color/text_tertiary"
        android:visibility="gone"
        tools:visibility="visible"
        xmlns:tools="http://schemas.android.com/tools" />

    <TextView
        android:id="@+id/row_bubble"
        style="@style/Widget.OperatorChat.Bubble.Out"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:maxWidth="280dp"
        android:textColor="@color/white" />

    <ImageView
        android:id="@+id/row_image"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:adjustViewBounds="true"
        android:maxWidth="240dp"
        android:maxHeight="320dp"
        android:scaleType="centerCrop"
        android:background="@drawable/bg_bubble_out"
        android:contentDescription="Attachment"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_file"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:paddingBottom="8dp"
        android:background="@drawable/bg_bubble_out"
        android:drawableStart="@drawable/ic_folder"
        android:drawablePadding="8dp"
        android:gravity="center_vertical"
        android:maxWidth="240dp"
        android:maxLines="2"
        android:ellipsize="middle"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/row_meta"
        style="@style/Widget.OperatorChat.Meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:paddingTop="3dp"
        android:paddingBottom="2dp" />
</LinearLayout>
