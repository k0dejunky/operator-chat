<?xml version="1.0" encoding="utf-8"?>
<!-- Outgoing (operator) bubble: Instagram gradient with a small tail at the
     bottom-right. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="315"
        android:startColor="@color/ig_gradient_start"
        android:centerColor="@color/ig_gradient_mid"
        android:endColor="@color/ig_gradient_end" />
    <corners
        android:topLeftRadius="20dp"
        android:topRightRadius="20dp"
        android:bottomLeftRadius="20dp"
        android:bottomRightRadius="4dp" />
</shape>