<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night is the app's only mode (the operator tool is used in dark rooms
         and the site is dark). Kept as an explicit override so the light theme
         can never leak a white background on a device in light mode. -->
    <style name="Theme.OperatorChat" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/brand_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:overScrollMode">ifContentScrolls</item>
    </style>
</resources>
