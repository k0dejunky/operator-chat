<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================
         Base theme. Material3 dark, no action bar (each screen owns its
         own toolbar so the header can show a subtitle + avatar).
         ================================================================ -->
    <style name="Theme.OperatorChat" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_container</item>
        <item name="colorOnPrimaryContainer">@color/text</item>
        <item name="colorSecondary">@color/brand_light</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text</item>
        <item name="colorSurfaceVariant">@color/surface_elevated</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorOutline">@color/border</item>
        <item name="android:colorBackground">@color/surface</item>
        <item name="android:windowBackground">@color/surface</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:overScrollMode">ifContentScrolls</item>
    </style>

    <!-- Toolbar title / subtitle pairing used by the chat header. -->
    <style name="Theme.OperatorChat.ToolbarTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">18sp</item>
    </style>

    <style name="Theme.OperatorChat.ToolbarSubtitle" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">12sp</item>
    </style>

    <!-- ================================================================
         Chat primitives. Named styles so a bubble never has to repeat
         padding/corner maths inline.
         ============================================================ -->
    <style name="Widget.OperatorChat.Bubble" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:paddingTop">9dp</item>
        <item name="android:paddingBottom">9dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:lineSpacingExtra">3dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Widget.OperatorChat.Bubble.In" parent="Widget.OperatorChat.Bubble">
        <item name="android:background">@drawable/bg_bubble_in</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Widget.OperatorChat.Bubble.Out" parent="Widget.OperatorChat.Bubble">
        <item name="android:background">@drawable/bg_bubble_out</item>
        <item name="android:textColor">@color/white</item>
    </style>

    <style name="Widget.OperatorChat.Meta" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>

    <!-- Inbox rows -->
    <style name="Widget.OperatorChat.ListTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.OperatorChat.ListSubtitle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="Widget.OperatorChat.ListMeta" parent="">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/text_tertiary</item>
    </style>
</resources>
