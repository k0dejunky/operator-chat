<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ================================================================
         Brand: a single amethyst accent. The old palette mixed an
         Instagram story gradient (purple -> red -> amber) with Snapchat
         yellow, which read as a toy. One accent, used consistently:
         outgoing bubbles, the unread badge and the send button.
         ================================================================ -->
    <color name="brand">#8B5CF6</color>
    <color name="brand_dark">#6D28D9</color>
    <color name="brand_light">#A78BFA</color>
    <color name="brand_container">#2A1B4D</color>

    <!-- Surfaces -->
    <color name="surface">#0E0E13</color>
    <color name="surface_card">#17171F</color>
    <color name="surface_elevated">#22222E</color>
    <color name="surface_input">#1B1B25</color>

    <!-- Content -->
    <color name="text">#F4F4F6</color>
    <color name="text_secondary">#9C9CA8</color>
    <color name="text_tertiary">#6E6E7C</color>
    <color name="border">#2B2B38</color>
    <color name="divider">#21212C</color>

    <!-- Feedback -->
    <color name="danger">#FF6B6B</color>
    <color name="success">#4ADE80</color>
    <color name="warning">#FBBF24</color>

    <color name="white">#FFFFFF</color>
    <color name="black">#000000</color>
    <color name="transparent">#00000000</color>
    <color name="scrim">#99000000</color>

    <!-- Backwards-compatible aliases so untouched layouts keep resolving. -->
    <color name="purple">#8B5CF6</color>
    <color name="purple_dark">#6D28D9</color>
    <color name="purple_light">#A78BFA</color>
    <color name="pink_100">#0D0D0D</color>
    <color name="ig_gradient_start">#8B5CF6</color>
    <color name="ig_gradient_mid">#8B5CF6</color>
    <color name="ig_gradient_end">#A78BFA</color>
    <color name="snap_yellow">#8B5CF6</color>

    <!-- Avatar accents: a small fixed palette so the inbox tiles read as
         distinct without any extra data from the server. -->
    <color name="avatar_1">#8B5CF6</color>
    <color name="avatar_2">#0EA5E9</color>
    <color name="avatar_3">#F43F5E</color>
    <color name="avatar_4">#10B981</color>
    <color name="avatar_5">#F59E0B</color>
</resources>
